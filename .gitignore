# dependencies & build output (never commit these)
node_modules/
dist/
dist-verify/
out/
build/

# logs / OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# built installers (in case any land outside dist/)
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.blockmap

# editor
.vscode/
.idea/

# local Sinrad state and crash-safe backups (may contain vault secrets)
sinrad-data*.json
sinrad-kill.json
*.sinrad-tmp

# Runtime data always lives in the OS app-data directory and is never tracked.
