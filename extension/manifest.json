{
  "manifest_version": 3,
  "name": "S.I.R Quick Save",
  "version": "1.3.3",
  "description": "Save links, park tabs and capture pages for S.I.R offline use",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms",
    "pageCapture",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:47821/*",
    "http://localhost:47821/*",
    "https://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quick save current page to S.I.R Links",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
